rules_version = '2';

// Regras do Firebase Storage — documentos dos clientes, imagens dos modelos e logo da empresa.
// Consulta o Firestore: usuário ativo, perfil e a tabela de permissões (config/permissoes).
service firebase.storage {
  match /b/{bucket}/o {

    function usuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ativo() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && usuario().ativo == true;
    }
    // Pode fazer a ação? (Administrador sempre; os demais conforme Usuários → Permissões por perfil.)
    function pode(acao) {
      return ativo() && (usuario().perfil == 'Administrador'
        || (firestore.exists(/databases/(default)/documents/config/permissoes)
            && firestore.get(/databases/(default)/documents/config/permissoes).data
                 .get(usuario().perfil, {}).get(acao, false) == true));
    }

    // Arquivos do perfil de cada cliente: anexados (RG, CPF, vias assinadas) e PDFs gerados.
    match /clientes/{clienteId}/{arquivo} {
      allow read: if ativo();
      allow create: if request.resource.size < 20 * 1024 * 1024
        && (pode('clientes_anexar') || pode('clientes_anexar_assinado') || pode('clientes_gerar') || pode('clientes_editar_gerado'));
      allow delete: if pode('clientes_excluir_anexo') || pode('clientes_excluir_gerado') || pode('clientes_editar_gerado');
      allow update: if false;
    }

    // Imagens do timbrado dos modelos de documentos (cabeçalho, rodapé e fundo).
    match /modelos/{arquivo} {
      allow read: if ativo();
      allow create: if pode('documentos_modelos') && request.resource.size < 15 * 1024 * 1024;
      allow delete: if pode('documentos_modelos');
      allow update: if false;
    }

    // Logo da empresa (Configurações → Empresa).
    match /empresa/{arquivo} {
      allow read: if ativo();
      allow create: if pode('config_empresa') && request.resource.size < 5 * 1024 * 1024;
      allow delete: if pode('config_empresa');
      allow update: if false;
    }

    // Qualquer outro caminho: bloqueado.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
